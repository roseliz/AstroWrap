#!/bin/bash
# Boot of the machine (Debian 12), at every boot. Output: Cloud Logging (google_metadata_script_runner) and
# journalctl -u google-startup-scripts.
set -euxo pipefail

META=http://metadata.google.internal/computeMetadata/v1

# ---------------------------------------------------------------- Docker
if ! command -v docker >/dev/null; then
  apt-get update
  DEBIAN_FRONTEND=noninteractive apt-get install -y docker.io
fi
mkdir -p /etc/docker
cat > /etc/docker/daemon.json <<'EOF'
{ "log-driver": "json-file", "log-opts": { "max-size": "10m", "max-file": "3" } }
EOF
systemctl enable docker
systemctl restart docker

# ---------------------------------------------------------------- data disk (stateful, kept)
DISK=/dev/disk/by-id/google-${device}
for i in $(seq 1 60); do [ -e "$DISK" ] && break; sleep 5; done
blkid "$DISK" || mkfs.ext4 -F -m 0 "$DISK"
mkdir -p /data
UUID=$(blkid -s UUID -o value "$DISK")
grep -q "$UUID" /etc/fstab || echo "UUID=$UUID /data ext4 defaults,nofail 0 2" >> /etc/fstab
mountpoint -q /data || mount /data

# Everything the server writes is in /data/app; whatever else is on the disk (but Caddy) is removed.
find /data -mindepth 1 -maxdepth 1 ! -name app ! -name caddy ! -name lost+found -exec rm -rf {} +
mkdir -p /data/app/pretreatment_data /data/app/cache /data/app/duckdb_tmp /data/caddy/data /data/caddy/config
chown -R 1000:1000 /data/app

# ---------------------------------------------------------------- data (Parquet files, from GCS)
# api-sync-data: copies the module results from the bucket (only what changed), with the machine's service account.
# publish.sh uploads them, then writes _READY; it also runs this script then restarts the container.
cat > /usr/local/bin/api-sync-data <<'EOF'
#!/bin/bash
set -euo pipefail
until gcloud storage ls gs://${bucket}/pretreatment_data/_READY >/dev/null 2>&1; do
  echo "waiting for the data in gs://${bucket}/pretreatment_data"; sleep 30
done
gcloud storage rsync gs://${bucket}/pretreatment_data /data/app/pretreatment_data --recursive \
  --delete-unmatched-destination-objects --exclude '^(?!.*\.parquet$).*' --quiet
chown -R 1000:1000 /data/app/pretreatment_data
EOF
chmod +x /usr/local/bin/api-sync-data
/usr/local/bin/api-sync-data

# ---------------------------------------------------------------- containers
# Artifact Registry login with the token of the machine's service account
login() {
  curl -sf -H "Metadata-Flavor: Google" "$META/instance/service-accounts/default/token" \
    | python3 -c 'import json, sys; print(json.load(sys.stdin)["access_token"])' \
    | docker login -u oauth2accesstoken --password-stdin https://${registry}
}
until login && docker pull ${image}; do
  echo "waiting for the image ${image}"; sleep 30
done
docker pull caddy:2

cat > /data/caddy/Caddyfile <<'EOF'
${domains} {
	encode gzip
	reverse_proxy server:8000
}

# Access by IP address (or any other name), and Google's health probes: plain HTTP
http:// {
	encode gzip
	reverse_proxy server:8000
}
EOF

docker network inspect web >/dev/null 2>&1 || docker network create web
docker rm -f server caddy 2>/dev/null || true

# Container output in Cloud Logging (gcplogs driver); docker logs still works (Docker's local cache)
LOGS="--log-driver gcplogs --log-opt gcp-meta-name=$(hostname)"

# 8 GB of memory: DuckDB gets 3 of them, 2 threads. A single uvicorn process: the areas sent by the interface are
# kept in memory (services/zones.py).
docker run -d --name server --restart unless-stopped --network web \
  $LOGS \
  -v /data/app:/data/app \
  -e ANALOGUES_CORS='${cors}' \
  -e ANALOGUES_DUCKDB_MEMORY=3GB \
  -e ANALOGUES_DUCKDB_THREADS=2 \
  ${image}

docker run -d --name caddy --restart unless-stopped --network web \
  $LOGS \
  -p 80:80 -p 443:443 \
  -v /data/caddy/Caddyfile:/etc/caddy/Caddyfile:ro \
  -v /data/caddy/data:/data \
  -v /data/caddy/config:/config \
  caddy:2

echo "startup done"
